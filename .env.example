# Local development must be enabled explicitly.
CLOCKIN_ENV=development
SECRET_KEY=replace-with-a-local-development-secret
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Production: set CLOCKIN_ENV=production and every DB_* value below.
# Use django.db.backends.postgresql for DB_ENGINE in production.
# Keep real credentials only in the untracked .env or process environment.
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
